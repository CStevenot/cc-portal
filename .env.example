# Vercel env for cc-portal. Never commit real values.
# Existing
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
RETELL_API_KEY=                       # must be the key Retell marks as the webhook key (it signs tool calls)
# Shopify app (Dev Dashboard app 427955388417)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_APP_HANDLE=client-connected
TOKEN_ENC_KEY=                        # openssl rand -base64 32 ; use a different key for Preview
BILLING_TEST=true                     # false only after App Store approval
PLAN_NAME=Client Connected
PLAN_PRICE=349
PLAN_INCLUDED_MIN=500
PLAN_OVERAGE_PER_MIN=0.65
PLAN_USAGE_CAP=500
CRON_SECRET=                          # random string; Vercel Cron sends it as a Bearer token
RESEND_API_KEY=                       # for ops emails (data requests, webhook errors)
OPS_EMAIL=                            # where ops emails go
OPS_FROM=Client Connected <ops@client-connected.com>   # must be a Resend-verified sender domain
